{
  "$defs": {
    "ConfigShowReport": {
      "description": "What `config show` prints: the resolved config and the file each part came from.",
      "properties": {
        "exclude": {
          "$ref": "#/$defs/PatternsJson",
          "description": "The files removed from `include`."
        },
        "features": {
          "$ref": "#/$defs/FeaturesJson",
          "description": "The feature settings in effect."
        },
        "files": {
          "description": "The config files in the chain, child first. Empty when running on defaults.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include": {
          "$ref": "#/$defs/PatternsJson",
          "description": "The files to read links from."
        },
        "limits": {
          "$ref": "#/$defs/LimitsJson",
          "description": "Every `[limits]` ceiling in effect and where it came from."
        },
        "lockfile": {
          "description": "The project's lockfile, whether or not it exists yet.",
          "type": "string"
        },
        "namespaces": {
          "description": "Every namespace, by name.",
          "items": {
            "$ref": "#/$defs/NamespaceJson"
          },
          "type": "array"
        }
      },
      "required": [
        "files",
        "lockfile",
        "include",
        "exclude",
        "namespaces",
        "features",
        "limits"
      ],
      "type": "object"
    },
    "FeaturesJson": {
      "description": "The `[features]` settings in effect.",
      "properties": {
        "hash": {
          "$ref": "#/$defs/HashFeatureJson",
          "description": "The `[features.hash]` settings."
        }
      },
      "required": [
        "hash"
      ],
      "type": "object"
    },
    "FindingJson": {
      "description": "A finding as JSON shows it.",
      "properties": {
        "fix": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixJson"
            },
            {
              "type": "null"
            }
          ],
          "description": "The one correct edit, when there is exactly one."
        },
        "help": {
          "description": "What to do next.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "The stable code, such as `link-failed`.",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocationJson"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where it is. Left out of a link's nested finding, which shares the link's location."
        },
        "message": {
          "description": "What happened, in one line.",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/SeverityJson",
          "description": "How bad it is."
        }
      },
      "required": [
        "kind",
        "severity",
        "message"
      ],
      "type": "object"
    },
    "FixJson": {
      "description": "An exact edit as JSON shows it, with byte offsets so a script can apply it without recounting.",
      "properties": {
        "end": {
          "description": "End byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "file": {
          "description": "The file to edit, relative to the project root.",
          "type": "string"
        },
        "replacement": {
          "description": "The new text.",
          "type": "string"
        },
        "start": {
          "description": "Start byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start",
        "end",
        "replacement"
      ],
      "type": "object"
    },
    "HashFeatureJson": {
      "description": "The `[features.hash]` table as `config show` reports it.",
      "properties": {
        "line_endings": {
          "$ref": "#/$defs/LineEndingsJson",
          "description": "How line endings are treated when hashing."
        }
      },
      "required": [
        "line_endings"
      ],
      "type": "object"
    },
    "LimitJson": {
      "description": "One limit and where it came from.",
      "properties": {
        "file": {
          "description": "The config file that set it, relative to the project root, when `source` is `config`.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/LimitSource",
          "description": "`flag`, `env`, `config` or `default`."
        },
        "value": {
          "description": "The ceiling with its unit, such as `10s` or `256KiB`; `0` for no limit.",
          "type": "string"
        }
      },
      "required": [
        "value",
        "source"
      ],
      "type": "object"
    },
    "LimitSource": {
      "description": "Where a limit's value came from, as JSON names it.",
      "oneOf": [
        {
          "const": "flag",
          "description": "The command-line flag.",
          "type": "string"
        },
        {
          "const": "env",
          "description": "The `SUPDOC_*` environment variable.",
          "type": "string"
        },
        {
          "const": "config",
          "description": "The config file named in `file`.",
          "type": "string"
        },
        {
          "const": "default",
          "description": "The built-in default.",
          "type": "string"
        }
      ]
    },
    "LimitsJson": {
      "description": "The `[limits]` ceilings in effect, each with where it came from.",
      "properties": {
        "max_config_size": {
          "$ref": "#/$defs/LimitJson",
          "description": "How large each config file may be. Set only by flag or environment variable."
        },
        "max_ignore_size": {
          "$ref": "#/$defs/LimitJson",
          "description": "How large each ignore file may be."
        },
        "max_lock_size": {
          "$ref": "#/$defs/LimitJson",
          "description": "How large `supdoc.lock` may be."
        },
        "parse_timeout": {
          "$ref": "#/$defs/LimitJson",
          "description": "How long one read of a file may take."
        }
      },
      "required": [
        "parse_timeout",
        "max_lock_size",
        "max_config_size",
        "max_ignore_size"
      ],
      "type": "object"
    },
    "LineEndings": {
      "description": "How line endings are treated before hashing (01 D10, 03 R6).",
      "oneOf": [
        {
          "const": "normalize",
          "description": "Each CR immediately followed by LF is dropped before hashing (B.4).",
          "type": "string"
        },
        {
          "const": "exact",
          "description": "Every byte is hashed as is.",
          "type": "string"
        }
      ]
    },
    "LineEndingsJson": {
      "description": "The `line-endings` setting and the file that set it.",
      "properties": {
        "file": {
          "description": "The config file that set it, relative to the project root. `null` for the default.",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "$ref": "#/$defs/LineEndings",
          "description": "`normalize` or `exact`."
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "LocationJson": {
      "description": "A place in a file as JSON shows it.",
      "properties": {
        "column": {
          "description": "1-based column, in characters.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "description": "End byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "file": {
          "description": "The file, relative to the project root.",
          "type": "string"
        },
        "line": {
          "description": "1-based line.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "description": "Start byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "line",
        "column",
        "start",
        "end"
      ],
      "type": "object"
    },
    "NamespaceJson": {
      "description": "One namespace as `config show` and `namespace list` show it.",
      "properties": {
        "exists": {
          "description": "Whether the directory exists now.",
          "type": "boolean"
        },
        "from": {
          "description": "The config file that defined it, relative to the project root.",
          "type": "string"
        },
        "name": {
          "description": "The namespace's name, as links write it before the colon.",
          "type": "string"
        },
        "path": {
          "description": "The directory it names, relative to the project root.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "from",
        "exists"
      ],
      "type": "object"
    },
    "PatternsJson": {
      "description": "The patterns of `include` or `exclude` and the file that set them.",
      "properties": {
        "from": {
          "description": "The config file that set them, relative to the project root. `null` for the default.",
          "type": [
            "string",
            "null"
          ]
        },
        "patterns": {
          "description": "The patterns as written, in order. The built-in default when `from` is `null`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "patterns"
      ],
      "type": "object"
    },
    "SeverityJson": {
      "description": "A severity as JSON shows it.",
      "oneOf": [
        {
          "const": "error",
          "description": "Fails `check`.",
          "type": "string"
        },
        {
          "const": "warning",
          "description": "Reported; fails `check` only under `--deny-warnings`.",
          "type": "string"
        },
        {
          "const": "note",
          "description": "Information only.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The one object every command writes under `--json`, with the same top-level keys each time.\n\nIts schema is the one `supdoc schema` prints, so the JSON written and the schema published\ncome from this one type.",
  "properties": {
    "command": {
      "const": "config show",
      "description": "The command that produced `data`.",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/ConfigShowReport",
      "description": "The command's own payload."
    },
    "findings": {
      "description": "Findings that aren't about one link.",
      "items": {
        "$ref": "#/$defs/FindingJson"
      },
      "type": "array"
    },
    "ok": {
      "description": "`true` exactly when the exit code is 0.",
      "type": "boolean"
    },
    "root": {
      "description": "The absolute project root, which every other path is relative to.",
      "type": "string"
    },
    "schema_version": {
      "description": "[`SCHEMA_VERSION`].",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "truncated": {
      "description": "Whether results were left out.",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "command",
    "ok",
    "root",
    "data",
    "findings",
    "truncated"
  ],
  "title": "Envelope",
  "type": "object"
}

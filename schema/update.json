{
  "$defs": {
    "Action": {
      "description": "What a lockfile change does to its entry.",
      "oneOf": [
        {
          "const": "accept",
          "description": "Replace a `failed` link's hash with the code's current one.",
          "type": "string"
        },
        {
          "const": "record",
          "description": "Add an entry for a link that had none.",
          "type": "string"
        },
        {
          "const": "remove",
          "description": "Drop an entry whose link is gone.",
          "type": "string"
        }
      ]
    },
    "ChangeJson": {
      "description": "One lockfile change as JSON shows it.",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action",
          "description": "What happens to the entry."
        },
        "locations": {
          "description": "Every place the link appears in its source. Empty for `remove`.",
          "items": {
            "$ref": "#/$defs/LinkLocationJson"
          },
          "type": "array"
        },
        "moved_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinkKey"
            },
            {
              "type": "null"
            }
          ],
          "description": "The entry a moved link carries its history from (05 C6)."
        },
        "source": {
          "$ref": "#/$defs/SourcePath",
          "description": "The file the link is written in."
        },
        "state": {
          "$ref": "#/$defs/LinkState",
          "description": "The link's state before the update."
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "`None` = whole file. `Option`'s ordering puts whole-file entries first. Left out of JSON\nwhen `None`."
        },
        "target": {
          "$ref": "#/$defs/Target",
          "description": "The file the link points at."
        }
      },
      "required": [
        "action",
        "state",
        "source",
        "target",
        "locations"
      ],
      "type": "object"
    },
    "FindingJson": {
      "description": "A finding as JSON shows it.",
      "properties": {
        "fix": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixJson"
            },
            {
              "type": "null"
            }
          ],
          "description": "The one correct edit, when there is exactly one."
        },
        "help": {
          "description": "What to do next.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "The stable code, such as `link-failed`.",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocationJson"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where it is. Left out of a link's nested finding, which shares the link's location."
        },
        "message": {
          "description": "What happened, in one line.",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/SeverityJson",
          "description": "How bad it is."
        }
      },
      "required": [
        "kind",
        "severity",
        "message"
      ],
      "type": "object"
    },
    "FixJson": {
      "description": "An exact edit as JSON shows it, with byte offsets so a script can apply it without recounting.",
      "properties": {
        "end": {
          "description": "End byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "file": {
          "description": "The file to edit, relative to the project root.",
          "type": "string"
        },
        "replacement": {
          "description": "The new text.",
          "type": "string"
        },
        "start": {
          "description": "Start byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start",
        "end",
        "replacement"
      ],
      "type": "object"
    },
    "LineEndings": {
      "description": "How line endings are treated before hashing (01 D10, 03 R6).",
      "oneOf": [
        {
          "const": "normalize",
          "description": "Each CR immediately followed by LF is dropped before hashing (B.4).",
          "type": "string"
        },
        {
          "const": "exact",
          "description": "Every byte is hashed as is.",
          "type": "string"
        }
      ]
    },
    "LineEndingsChange": {
      "description": "One setting's recorded value and the value it is re-recorded with.",
      "properties": {
        "from": {
          "$ref": "#/$defs/LineEndings",
          "description": "The value the lockfile records."
        },
        "to": {
          "$ref": "#/$defs/LineEndings",
          "description": "The value the config resolves to."
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "LinkKey": {
      "description": "Identity of one lock entry (02 L2). Field order is the sort order (02 L1).",
      "properties": {
        "source": {
          "$ref": "#/$defs/SourcePath",
          "description": "The file the link is written in."
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "`None` = whole file. `Option`'s ordering puts whole-file entries first. Left out of JSON\nwhen `None`."
        },
        "target": {
          "$ref": "#/$defs/Target",
          "description": "The file the link points at."
        }
      },
      "required": [
        "source",
        "target"
      ],
      "type": "object"
    },
    "LinkLocationJson": {
      "description": "Where a link appears in its source. The file is the link's `source`, so it isn't repeated.",
      "properties": {
        "column": {
          "description": "1-based column, in characters.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "description": "End byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "line": {
          "description": "1-based line.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "description": "Start byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "line",
        "column",
        "start",
        "end"
      ],
      "type": "object"
    },
    "LinkState": {
      "description": "Where one link stands, in snapshot-testing terms (05 C1).\n\nThe same values name states everywhere: in reports, in `--state` filters on `update` and\n`list`, and in JSON output.",
      "oneOf": [
        {
          "const": "passed",
          "description": "The target's hash matches the lock entry.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "The target's hash differs from the lock entry: the code changed since the doc was confirmed.",
          "type": "string"
        },
        {
          "const": "broken",
          "description": "The target file, symbol or namespace can't be found.",
          "type": "string"
        },
        {
          "const": "new",
          "description": "The link has no lock entry yet.",
          "type": "string"
        },
        {
          "const": "obsolete",
          "description": "A lock entry whose link no longer exists.",
          "type": "string"
        }
      ]
    },
    "LocationJson": {
      "description": "A place in a file as JSON shows it.",
      "properties": {
        "column": {
          "description": "1-based column, in characters.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "description": "End byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "file": {
          "description": "The file, relative to the project root.",
          "type": "string"
        },
        "line": {
          "description": "1-based line.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "description": "Start byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "line",
        "column",
        "start",
        "end"
      ],
      "type": "object"
    },
    "SettingsChangeJson": {
      "description": "How the lockfile's hash settings change, as JSON shows it:\n`{\"line_endings\": {\"from\": \"exact\", \"to\": \"normalize\"}}` (B-Q6).",
      "properties": {
        "line_endings": {
          "$ref": "#/$defs/LineEndingsChange",
          "description": "`[features.hash] line-endings`."
        }
      },
      "required": [
        "line_endings"
      ],
      "type": "object"
    },
    "SeverityJson": {
      "description": "A severity as JSON shows it.",
      "oneOf": [
        {
          "const": "error",
          "description": "Fails `check`.",
          "type": "string"
        },
        {
          "const": "warning",
          "description": "Reported; fails `check` only under `--deny-warnings`.",
          "type": "string"
        },
        {
          "const": "note",
          "description": "Information only.",
          "type": "string"
        }
      ]
    },
    "SourcePath": {
      "description": "A file path relative to the project root, with `/` separators.",
      "type": "string"
    },
    "Summary": {
      "description": "How many links are in each state.",
      "properties": {
        "broken": {
          "description": "Links whose target can't be found.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "failed": {
          "description": "Links whose target changed since the doc was confirmed.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "new": {
          "description": "Links with no lock entry yet.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "obsolete": {
          "description": "Lock entries whose link no longer exists.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "description": "Links whose target still matches the lockfile.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "failed",
        "broken",
        "new",
        "obsolete"
      ],
      "type": "object"
    },
    "SymbolPath": {
      "description": "A dotted symbol path such as `Config.validate`.",
      "type": "string"
    },
    "Target": {
      "description": "Where a link points: `path` or `namespace:path`.",
      "type": "string"
    },
    "UpdateReport": {
      "description": "`supdoc update`: the planned or applied lockfile changes.",
      "properties": {
        "applied": {
          "description": "`false` for a preview: nothing was written.",
          "type": "boolean"
        },
        "changes": {
          "description": "One per lockfile change, in plan order.",
          "items": {
            "$ref": "#/$defs/ChangeJson"
          },
          "type": "array"
        },
        "settings_change": {
          "anyOf": [
            {
              "$ref": "#/$defs/SettingsChangeJson"
            },
            {
              "type": "null"
            }
          ],
          "description": "The hash settings the lockfile is re-recorded under. Left out when they don't change."
        },
        "states": {
          "description": "The `--state` values in effect.",
          "items": {
            "$ref": "#/$defs/LinkState"
          },
          "type": "array"
        },
        "summary": {
          "$ref": "#/$defs/Summary",
          "description": "How many links in scope were in each state before the update."
        }
      },
      "required": [
        "applied",
        "states",
        "changes",
        "summary"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The one object every command writes under `--json`, with the same top-level keys each time.\n\nIts schema is the one `supdoc schema` prints, so the JSON written and the schema published\ncome from this one type.",
  "properties": {
    "command": {
      "const": "update",
      "description": "The command that produced `data`.",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/UpdateReport",
      "description": "The command's own payload."
    },
    "findings": {
      "description": "Findings that aren't about one link.",
      "items": {
        "$ref": "#/$defs/FindingJson"
      },
      "type": "array"
    },
    "ok": {
      "description": "`true` exactly when the exit code is 0.",
      "type": "boolean"
    },
    "root": {
      "description": "The absolute project root, which every other path is relative to.",
      "type": "string"
    },
    "schema_version": {
      "description": "[`SCHEMA_VERSION`].",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "truncated": {
      "description": "Whether results were left out.",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "command",
    "ok",
    "root",
    "data",
    "findings",
    "truncated"
  ],
  "title": "Envelope",
  "type": "object"
}

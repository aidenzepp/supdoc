{
  "$defs": {
    "Direction": {
      "description": "Which way the install moves relative to the version that is running.",
      "oneOf": [
        {
          "const": "upgrade",
          "description": "The target is newer.",
          "type": "string"
        },
        {
          "const": "downgrade",
          "description": "The target is older.",
          "type": "string"
        },
        {
          "const": "same",
          "description": "The target is the running version.",
          "type": "string"
        }
      ]
    },
    "FindingJson": {
      "description": "A finding as JSON shows it.",
      "properties": {
        "fix": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixJson"
            },
            {
              "type": "null"
            }
          ],
          "description": "The one correct edit, when there is exactly one."
        },
        "help": {
          "description": "What to do next.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "The stable code, such as `link-failed`.",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocationJson"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where it is. Left out of a link's nested finding, which shares the link's location."
        },
        "message": {
          "description": "What happened, in one line.",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/SeverityJson",
          "description": "How bad it is."
        }
      },
      "required": [
        "kind",
        "severity",
        "message"
      ],
      "type": "object"
    },
    "FixJson": {
      "description": "An exact edit as JSON shows it, with byte offsets so a script can apply it without recounting.",
      "properties": {
        "end": {
          "description": "End byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "file": {
          "description": "The file to edit, relative to the project root.",
          "type": "string"
        },
        "replacement": {
          "description": "The new text.",
          "type": "string"
        },
        "start": {
          "description": "Start byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start",
        "end",
        "replacement"
      ],
      "type": "object"
    },
    "LocationJson": {
      "description": "A place in a file as JSON shows it.",
      "properties": {
        "column": {
          "description": "1-based column, in characters.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "description": "End byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "file": {
          "description": "The file, relative to the project root.",
          "type": "string"
        },
        "line": {
          "description": "1-based line.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "description": "Start byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "line",
        "column",
        "start",
        "end"
      ],
      "type": "object"
    },
    "Method": {
      "description": "How this supdoc was installed, and so how it would be upgraded.",
      "oneOf": [
        {
          "const": "cargo",
          "description": "`cargo install` from crates.io.",
          "type": "string"
        },
        {
          "const": "release-binary",
          "description": "A binary downloaded from a GitHub release.",
          "type": "string"
        }
      ]
    },
    "SeverityJson": {
      "description": "A severity as JSON shows it.",
      "oneOf": [
        {
          "const": "error",
          "description": "Fails `check`.",
          "type": "string"
        },
        {
          "const": "warning",
          "description": "Reported; fails `check` only under `--deny-warnings`.",
          "type": "string"
        },
        {
          "const": "note",
          "description": "Information only.",
          "type": "string"
        }
      ]
    },
    "UpgradeOutcome": {
      "description": "How the run ended.",
      "oneOf": [
        {
          "const": "previewed",
          "description": "Nothing was run; this is the command that would be.",
          "type": "string"
        },
        {
          "const": "installed",
          "description": "Cargo installed the target.",
          "type": "string"
        },
        {
          "const": "already-current",
          "description": "The target is the running version, so nothing ran.",
          "type": "string"
        }
      ]
    },
    "UpgradeReport": {
      "description": "`supdoc upgrade`: the versions, and what installs the target.",
      "properties": {
        "asset": {
          "description": "The release archive URL the target would come from; only for a release binary that has a\nversion to install.",
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "description": "The command that installs the target, as an argument vector; empty when nothing would run\nand for a release binary.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "current": {
          "description": "The version that is running.",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction",
          "description": "`upgrade`, `downgrade`, or `same` when the target is the running version."
        },
        "method": {
          "$ref": "#/$defs/Method",
          "description": "How this supdoc was installed: `cargo` or `release-binary`."
        },
        "outcome": {
          "$ref": "#/$defs/UpgradeOutcome",
          "description": "How the run ended."
        },
        "ran": {
          "description": "Whether the command ran.",
          "type": "boolean"
        },
        "sha256": {
          "description": "The SHA-256 the archive must have, from `SHA256SUMS`; only with `asset`.",
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "description": "The version to install.",
          "type": "string"
        }
      },
      "required": [
        "current",
        "target",
        "direction",
        "command",
        "ran",
        "outcome",
        "method"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The one object every command writes under `--json`, with the same top-level keys each time.\n\nIts schema is the one `supdoc schema` prints, so the JSON written and the schema published\ncome from this one type.",
  "properties": {
    "command": {
      "const": "upgrade",
      "description": "The command that produced `data`.",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/UpgradeReport",
      "description": "The command's own payload."
    },
    "findings": {
      "description": "Findings that aren't about one link.",
      "items": {
        "$ref": "#/$defs/FindingJson"
      },
      "type": "array"
    },
    "ok": {
      "description": "`true` exactly when the exit code is 0.",
      "type": "boolean"
    },
    "root": {
      "description": "The absolute project root, which every other path is relative to.",
      "type": "string"
    },
    "schema_version": {
      "description": "[`SCHEMA_VERSION`].",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "truncated": {
      "description": "Whether results were left out.",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "command",
    "ok",
    "root",
    "data",
    "findings",
    "truncated"
  ],
  "title": "Envelope",
  "type": "object"
}

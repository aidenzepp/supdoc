{
  "$defs": {
    "FindingJson": {
      "description": "A finding as JSON shows it.",
      "properties": {
        "fix": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixJson"
            },
            {
              "type": "null"
            }
          ],
          "description": "The one correct edit, when there is exactly one."
        },
        "help": {
          "description": "What to do next.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "The stable code, such as `link-failed`.",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocationJson"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where it is. Left out of a link's nested finding, which shares the link's location."
        },
        "message": {
          "description": "What happened, in one line.",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/SeverityJson",
          "description": "How bad it is."
        }
      },
      "required": [
        "kind",
        "severity",
        "message"
      ],
      "type": "object"
    },
    "FixJson": {
      "description": "An exact edit as JSON shows it, with byte offsets so a script can apply it without recounting.",
      "properties": {
        "end": {
          "description": "End byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "file": {
          "description": "The file to edit, relative to the project root.",
          "type": "string"
        },
        "replacement": {
          "description": "The new text.",
          "type": "string"
        },
        "start": {
          "description": "Start byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start",
        "end",
        "replacement"
      ],
      "type": "object"
    },
    "LocationJson": {
      "description": "A place in a file as JSON shows it.",
      "properties": {
        "column": {
          "description": "1-based column, in characters.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "description": "End byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "file": {
          "description": "The file, relative to the project root.",
          "type": "string"
        },
        "line": {
          "description": "1-based line.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "description": "Start byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "line",
        "column",
        "start",
        "end"
      ],
      "type": "object"
    },
    "ResolveReport": {
      "description": "What `resolve` prints: the symbols of one file, or the one symbol asked for.\n\nJSON puts `file`, `query` and `symbols` under `data`; the envelope carries the warning for a\nfile with syntax errors.",
      "properties": {
        "file": {
          "description": "The file, relative to the project root. `..` climbs out of it for a file outside.",
          "type": "string"
        },
        "query": {
          "description": "The `SYMBOL` that was resolved. Left out when listing.",
          "type": [
            "string",
            "null"
          ]
        },
        "symbols": {
          "description": "The symbols shown: every symbol up to `--limit` in file order, or the one resolved.",
          "items": {
            "$ref": "#/$defs/SymbolJson"
          },
          "type": "array"
        }
      },
      "required": [
        "file",
        "symbols"
      ],
      "type": "object"
    },
    "SeverityJson": {
      "description": "A severity as JSON shows it.",
      "oneOf": [
        {
          "const": "error",
          "description": "Fails `check`.",
          "type": "string"
        },
        {
          "const": "warning",
          "description": "Reported; fails `check` only under `--deny-warnings`.",
          "type": "string"
        },
        {
          "const": "note",
          "description": "Information only.",
          "type": "string"
        }
      ]
    },
    "SymbolJson": {
      "description": "One symbol as `resolve --json` shows it.",
      "properties": {
        "aliases": {
          "description": "Other paths that resolve to the same symbol, such as a Markdown heading's anchor.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "column": {
          "description": "1-based column where the symbol starts, in characters.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "end": {
          "description": "End byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "line": {
          "description": "1-based line where the symbol starts.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "The full dotted path: `Config.validate`.",
          "type": "string"
        },
        "start": {
          "description": "Start byte offset.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "aliases",
        "line",
        "column",
        "start",
        "end"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The one object every command writes under `--json`, with the same top-level keys each time.\n\nIts schema is the one `supdoc schema` prints, so the JSON written and the schema published\ncome from this one type.",
  "properties": {
    "command": {
      "const": "resolve",
      "description": "The command that produced `data`.",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/ResolveReport",
      "description": "The command's own payload."
    },
    "findings": {
      "description": "Findings that aren't about one link.",
      "items": {
        "$ref": "#/$defs/FindingJson"
      },
      "type": "array"
    },
    "ok": {
      "description": "`true` exactly when the exit code is 0.",
      "type": "boolean"
    },
    "root": {
      "description": "The absolute project root, which every other path is relative to.",
      "type": "string"
    },
    "schema_version": {
      "description": "[`SCHEMA_VERSION`].",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "truncated": {
      "description": "Whether results were left out.",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "command",
    "ok",
    "root",
    "data",
    "findings",
    "truncated"
  ],
  "title": "Envelope",
  "type": "object"
}
